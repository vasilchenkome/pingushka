POSTGRES_USER=pingushka
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
POSTGRES_DB=pingushka
DATABASE_URL=postgresql://pingushka:replace-with-a-long-random-local-password@localhost:5432/pingushka
PUBLIC_URL=http://localhost:8080
COOKIE_SECURE=false
ALERT_SECRET_KEY=replace-with-32-byte-hex-or-base64
ALERT_EVALUATE_INTERVAL_SECS=30
TELEGRAM_API_BASE=https://api.telegram.org
DOMAIN=monitor.example.com
PINGUSHKA_VERSION=latest
INSTALL_SCRIPT_URL=https://raw.githubusercontent.com/vasilchenkome/pingushka/main/install.sh
